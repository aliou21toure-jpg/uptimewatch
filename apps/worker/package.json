    "@uptimewatch/domain": "workspace:*",
    "@uptimewatch/monitoring": "workspace:*",
    "@uptimewatch/queue": "workspace:*",
    "bullmq": "^6.7.6",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^5.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0",
    "@testcontainers/postgresql": "^11.0.0",
    "@testcontainers/redis": "^11.0.0"
  }
}

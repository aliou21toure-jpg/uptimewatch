# Copy to .env — never commit real secrets.
NODE_ENV=development
DATABASE_URL=postgres://uptimewatch:uptimewatch@localhost:5432/uptimewatch
REDIS_URL=redis://localhost:6379

# Web application
APP_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters
# Optional in development: without it, emails (verification, reset, invitations) are printed to the web server console.
RESEND_API_KEY=
# console | resend — defaults to console in development, resend in production.
EMAIL_TRANSPORT=
EMAIL_FROM=UptimeWatch <onboarding@resend.dev>

{
  "name": "uptimewatch",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "db:generate": "pnpm --filter @uptimewatch/db generate",
    "db:migrate": "pnpm --filter @uptimewatch/db migrate",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.15.0",
    "turbo": "^2.11.11",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.2"
  }
}
